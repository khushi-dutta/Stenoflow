.editorial-home{--paper:#f5f4ee;--forest:#284b3a;--line:#d8dcd2;background:var(--paper);color:#232b25;font-family:'Segoe UI',Arial,sans-serif;font-size:15px}
.editorial-home a:hover{opacity:1}.home-header,.home-hero,.home-exam-index,.home-discipline-section,.home-library-section,.home-footer{max-width:1320px;margin-inline:auto}
.home-header{height:100px;display:flex;align-items:center;justify-content:space-between;padding:0 48px;gap:28px;border-bottom:1px solid var(--line)}
.home-navigation,.home-account{display:flex;align-items:center;gap:28px;font-size:13px;font-weight:500}.home-navigation a:hover,.home-account>a:first-child:hover{color:#52745a}.home-account{gap:24px}.home-button{display:inline-flex;justify-content:center;align-items:center;gap:22px;min-height:52px;padding:14px 23px;border:1px solid transparent;border-radius:4px;font-size:14px;font-weight:600;letter-spacing:-.15px}.home-button-dark{background:#284b3a;color:#fff}.home-button-dark:hover{background:#183c2c;transform:translateY(-2px)}.home-header .home-button{min-height:43px;padding:10px 16px;font-size:12px;gap:16px}.home-mobile-menu{display:none}.home-skip{position:absolute;top:8px;left:15px;transform:translateY(-200%);background:white;padding:12px;z-index:100}.home-skip:focus{transform:none}
.home-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:54px;padding:64px 48px 68px;align-items:center}.home-kicker{font-size:10px;font-weight:650;letter-spacing:1.8px;margin:0 0 28px;line-height:1.5;display:flex;align-items:center;gap:10px}.home-kicker>span{height:6px;width:6px;background:#52745a;border-radius:50%}.home-hero h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(48px,4.8vw,68px);font-weight:400;letter-spacing:-3px;line-height:1.075;margin:0 0 26px}.editorial-home h1 em,.editorial-home h2 em{font-weight:400;color:#55745c}.home-hero-description{font-size:16px;line-height:1.8;color:#667064;max-width:410px;margin-bottom:30px}.home-hero-actions{display:flex;align-items:center;gap:28px}.home-text-link{display:inline-flex;align-items:center;gap:13px;font-size:13px;font-weight:600;padding:10px 0}.home-text-link:hover{color:#52745a}.home-hero-note{display:flex;align-items:center;gap:28px;margin-top:25px;font-size:11px;color:#626e5d}.home-language-note{display:flex;align-items:center;gap:10px}.home-language-note i{height:12px;border-left:1px solid #b8c0b1}
.home-studio{background:#dfe5d7;padding:23px 28px 20px;position:relative;border-radius:5px}.home-studio-label,.home-studio-foot{display:flex;justify-content:space-between;align-items:center;color:#56664e;font-size:9px;letter-spacing:1.1px}.home-studio-label{margin-bottom:20px}.home-studio-sheet{background:#fffef9;border:1px solid #ced5c6;box-shadow:0 9px 18px #273d2510;border-radius:3px;position:relative}.home-sheet-top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e3e5db;padding:16px 24px;color:#5b6958;font-size:11px}.home-sheet-top>span{display:flex;align-items:center;gap:8px}.home-sheet-title{padding:27px 27px 18px}.home-small-label{font-size:9px;font-weight:600;letter-spacing:1.35px;color:#626e5d}.home-sheet-title h2{font-family:Georgia,serif;font-size:33px;font-weight:400;line-height:1.18;letter-spacing:-.9px;margin:13px 0 9px}.home-sheet-title p{font-size:11px;color:#626e5d;margin:0}.home-recording{display:flex;align-items:center;gap:16px;padding:17px 25px;border-block:1px solid #e3e5db;background:#f4f6ef}.home-recording-play{height:38px;width:38px;border:1px solid #284b3a;border-radius:50%;color:#284b3a;display:grid;place-items:center;flex-shrink:0}.home-recording-play svg{margin-left:2px}.home-recording-play:hover{background:#284b3a;color:white}.home-recording-wave{display:flex;align-items:center;justify-content:space-between;height:40px;gap:3px;flex:1;overflow:hidden;min-width:0}.home-recording-wave i{width:2px;flex-shrink:0;background:#718563;border-radius:2px}.home-recording>span{font-size:25px;font-weight:500;letter-spacing:-1px}.home-recording small{display:block;font-size:8px;letter-spacing:1px;text-align:center;color:#6a7761}.home-sheet-excerpt{padding:23px 27px 7px}.home-sheet-excerpt p{font:18px/1.65 Georgia,serif;color:#53604e;margin:10px 0 18px}.home-sheet-link{display:flex;justify-content:space-between;align-items:center;padding:15px 27px;border-top:1px solid #e3e5db;font-size:11px;font-weight:600;color:#284b3a}.home-sheet-link:hover{background:#f4f6ef}.home-studio-foot{margin-top:18px}.home-studio-foot>span:first-child{font-family:Georgia,serif;font-style:italic;font-size:13px;letter-spacing:0}.home-studio-foot>span:last-child{font-size:8px}
.home-exam-index{display:flex;justify-content:space-between;align-items:center;gap:24px;border-block:1px solid var(--line);padding:28px 48px}.home-exam-index>span:first-child{font-size:9px;letter-spacing:1px;color:#626e5d;max-width:90px;line-height:1.6}.home-exam-index>span:last-child{font-size:10px;color:#626e5d;max-width:100px;text-align:right;line-height:1.6}.home-exam-index>div{display:flex;justify-content:space-between;gap:38px;flex:1;max-width:720px}.home-exam-index a{font-size:14px;font-weight:600;color:#586253}.home-exam-index a:hover{color:#284b3a}
.home-discipline-section{padding:95px 48px 100px;scroll-margin-top:24px}.home-section-heading>.home-kicker{margin-bottom:20px}.home-section-heading>div{display:flex;align-items:end;justify-content:space-between;gap:40px}.home-section-heading h2,.home-library-heading h2{font-family:Georgia,serif;font-size:43px;font-weight:400;line-height:1.17;letter-spacing:-1.4px;margin:0}.home-section-heading>div>p{font-size:14px;color:#626e5d;max-width:315px;margin:0 0 3px}.home-disciplines{display:grid;grid-template-columns:repeat(3,1fr);margin-top:45px;border-top:1px solid #bfc8b8}.home-discipline{padding:25px 30px 0 0;display:flex;flex-direction:column}.home-discipline+.home-discipline{border-left:1px solid var(--line);padding-left:30px}.home-discipline-heading{display:flex;justify-content:space-between;align-items:center;color:#6d7f61;font-family:monospace;font-size:11px}.home-discipline-heading svg{transition:transform .2s}.home-discipline:hover .home-discipline-heading svg{transform:translate(3px,-3px)}.home-discipline h3{font-size:24px;letter-spacing:-.7px;font-weight:500;margin:36px 0 12px}.home-discipline strong{font-size:13px;font-weight:500}.home-discipline p{font-size:13px;color:#626e5d;margin:10px 0 27px;line-height:1.8;flex:1}.home-discipline-link{font-size:11px;font-weight:600;display:flex;gap:13px;align-items:center}
.home-review-section{background:#243f32;color:#f1f1e8;display:grid;grid-template-columns:1fr 1fr;gap:90px;padding:77px max(48px,calc((100vw - 1224px)/2));align-items:center}.home-review-copy>.home-kicker{color:#b3c2a9;font-size:9px;margin-bottom:25px}.home-review-copy h2{font:400 53px/1.12 Georgia,serif;letter-spacing:-1.6px;margin:0 0 25px}.home-review-copy h2 em{color:#bfd0ae}.home-review-copy>p:not(.home-kicker){font-size:14px;color:#b9c5b7;max-width:370px;line-height:1.8}.home-review-copy .home-text-link{margin-top:13px;color:#e1e8d9}.home-review-example{background:#f8f7f1;color:#26362a;border-radius:3px;overflow:hidden}.home-review-example-top{display:flex;justify-content:space-between;padding:20px 25px;border-bottom:1px solid #d9dfd1;font-size:9px;letter-spacing:.8px}.home-review-example-top>span:last-child{letter-spacing:0;color:#626e5d}.home-proof{padding:30px 28px 25px}.home-proof p{font:25px/1.8 Georgia,serif;letter-spacing:-.4px;margin:15px 0 0}.proof-error{background:#f4dfd2;text-decoration:underline;text-decoration-color:#b16d4d;text-underline-offset:6px}.proof-missing{color:#537951;background:#e2ebd8;border-bottom:1px dashed #64845d}.home-correction{margin:0 28px;padding:17px 0;display:flex;align-items:center;gap:17px;border-top:1px solid #d9dfd1}.home-correction-number{font:11px monospace;color:#626e5d}.home-correction .home-small-label{font-size:8px}.home-correction p{display:flex;align-items:center;gap:12px;margin:5px 0 0;font-size:13px}.home-correction del{color:#9c7561}.home-correction strong{font-weight:500}.home-correction-tag{margin-left:auto;font-size:9px;color:#626e5d}.home-review-bottom{display:flex;justify-content:space-between;padding:20px 28px;font-size:10px;color:#66745e;background:#e9eddf}
.home-library-section{padding:94px 48px}.home-library-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:35px;gap:20px}.home-library-heading .home-kicker{margin-bottom:20px}.home-catalog{border-top:1px solid #bfc8b8}.home-catalog-row{display:grid;grid-template-columns:30px minmax(0,1fr) 110px 85px 78px 25px;gap:23px;align-items:center;padding:29px 8px;border-bottom:1px solid var(--line)}.home-catalog-row:hover{background:#ecefe4}.home-catalog-number{font:11px monospace;color:#626e5d}.home-catalog-title>span{font-size:10px;color:#626e5d}.home-catalog-title h3{font:400 23px/1.3 Georgia,serif;margin:7px 0 0;letter-spacing:-.4px}.home-catalog-level{font-size:11px;color:#626e5d}.home-catalog-speed{font-size:21px;font-weight:500;font-variant-numeric:tabular-nums}.home-catalog-speed small{font-size:9px;font-weight:400;color:#626e5d}.home-catalog-words{font-size:11px;color:#626e5d}.home-catalog-row>svg{color:#66775d}.home-catalog-note{font-size:11px;color:#626e5d;margin:20px 0 0}
.home-closing{text-align:center;background:#e7ebdf;border-block:1px solid var(--line);padding:70px 24px 66px}.home-closing>.home-kicker{justify-content:center;color:#68785e;margin-bottom:22px}.home-closing h2{font:400 52px/1.14 Georgia,serif;letter-spacing:-1.7px;margin:0 0 28px}.home-closing>p{font-size:11px;color:#626e5d;margin:16px 0 0}.home-footer{padding:45px 48px 24px}.home-footer-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:37px}.home-footer-top p{font-size:11px;color:#626e5d;margin:12px 0 0}.home-footer-top nav{display:flex;gap:30px;font-size:12px}.home-footer-bottom{padding-top:22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;font-size:10px;color:#626e5d}.home-footer-bottom>div{display:flex;gap:22px}
@media(min-width:1500px){.home-hero{gap:80px;padding-block:80px}.home-hero h1{font-size:74px}}
@media(max-width:1100px){.home-header{padding-inline:30px}.home-navigation{gap:18px;font-size:12px}.home-account{gap:16px}.home-account>a:first-child{display:none}.home-hero{padding-inline:30px;gap:30px}.home-hero h1{font-size:55px}.home-studio{padding-inline:20px}.home-exam-index{padding-inline:30px}.home-exam-index>div{gap:23px}.home-exam-index>span:last-child{display:none}.home-discipline-section,.home-library-section{padding-inline:30px}.home-review-section{gap:45px;padding-inline:40px}.home-review-copy h2{font-size:47px}.home-catalog-row{gap:16px;grid-template-columns:25px minmax(0,1fr) 95px 70px 70px 20px}.home-footer{padding-inline:30px}}
@media(max-width:850px){.home-navigation{display:none}.home-header{height:82px}.home-account{margin-left:auto}.home-mobile-menu{display:block;position:relative}.home-mobile-menu summary{cursor:pointer;list-style:none;display:flex}.home-mobile-menu summary::-webkit-details-marker{display:none}.home-mobile-menu nav{position:absolute;right:0;top:40px;width:240px;background:#fffef9;border:1px solid var(--line);z-index:10;padding:15px;box-shadow:0 8px 20px #23362216}.home-mobile-menu nav a{display:block;padding:11px;font-size:13px}.home-hero{grid-template-columns:1fr 1fr;gap:25px;padding-top:48px}.home-hero h1{font-size:44px;letter-spacing:-2px}.home-hero-description{font-size:14px}.home-hero-actions{align-items:start;flex-direction:column;gap:8px}.home-hero-note{flex-direction:column;align-items:start;gap:8px;margin-top:16px}.home-kicker{font-size:8px;letter-spacing:1.2px}.home-studio{padding:17px 15px}.home-sheet-title{padding:23px 20px 18px}.home-sheet-title h2{font-size:27px}.home-recording{gap:12px;padding:16px}.home-recording-wave{gap:2px}.home-sheet-excerpt{padding-inline:20px}.home-sheet-excerpt p{font-size:16px}.home-studio-label{font-size:7px;letter-spacing:.5px}.home-studio-foot>span:last-child{display:none}.home-section-heading h2,.home-library-heading h2{font-size:37px}.home-section-heading>div>p{max-width:230px;font-size:12px}.home-discipline-section{padding-block:65px}.home-discipline{padding-right:20px}.home-discipline+.home-discipline{padding-left:20px}.home-discipline h3{font-size:21px}.home-discipline strong,.home-discipline p{font-size:12px}.home-review-section{gap:30px;padding:55px 30px}.home-review-copy h2{font-size:40px}.home-proof{padding:24px 22px}.home-proof p{font-size:21px}.home-correction{margin-inline:22px}.home-correction-tag{display:none}.home-review-example-top{font-size:8px;gap:10px;padding-inline:22px}.home-catalog-row{grid-template-columns:24px minmax(0,1fr) 75px 22px}.home-catalog-level,.home-catalog-words{display:none}.home-catalog-title h3{font-size:21px}.home-library-section{padding-block:65px}}
@media(max-width:600px){.home-header{height:76px;padding-inline:22px;gap:16px}.home-header .brand{font-size:25px}.home-header .brand-symbol{width:28px;height:28px}.home-header .home-button{padding:9px 12px;min-height:38px;font-size:10px;gap:7px}.home-header .home-button svg{width:13px}.home-hero{display:block;padding:43px 22px}.home-hero h1{font-size:clamp(42px,11.5vw,61px);letter-spacing:-2.3px;line-height:1.1}.home-hero .home-kicker{font-size:9px;margin-bottom:23px}.home-hero-description{font-size:15px;max-width:390px;margin-bottom:24px}.home-hero-actions{flex-direction:row;align-items:center;gap:22px}.home-hero-actions .home-button{font-size:13px;padding-inline:18px;gap:14px}.home-text-link{font-size:12px}.home-hero-note{flex-direction:row;gap:22px;font-size:10px}.home-studio{margin-top:38px;padding:21px 22px}.home-studio-label{font-size:8px;letter-spacing:.7px}.home-sheet-title h2{font-size:32px}.home-sheet-excerpt p{font-size:18px}.home-recording{padding:16px 22px}.home-sheet-top{padding-inline:22px}.home-studio-foot>span:last-child{display:block}.home-exam-index{display:block;padding:23px 22px}.home-exam-index>span:first-child{display:block;max-width:none;font-size:8px;margin-bottom:15px}.home-exam-index>div{flex-wrap:wrap;justify-content:start;gap:14px 23px}.home-exam-index a{font-size:12px}.home-discipline-section{padding:54px 22px}.home-section-heading>div{display:block}.home-section-heading h2,.home-library-heading h2{font-size:36px}.home-section-heading>div>p{margin-top:20px;max-width:330px;font-size:13px}.home-disciplines{grid-template-columns:1fr;margin-top:28px}.home-discipline{padding:23px 0 27px}.home-discipline+.home-discipline{padding:23px 0 27px;border-left:0;border-top:1px solid var(--line)}.home-discipline h3{margin:16px 0 12px;font-size:26px}.home-discipline strong{font-size:12px}.home-discipline p{margin-top:9px;font-size:13px;max-width:360px}.home-review-section{grid-template-columns:1fr;padding:48px 22px;gap:30px}.home-review-copy h2{font-size:46px}.home-review-copy>p:not(.home-kicker){max-width:none;font-size:14px}.home-review-copy .home-text-link{margin-top:4px}.home-review-example-top{padding:20px;font-size:8px}.home-proof p{font-size:24px}.home-correction-tag{display:block}.home-library-section{padding:53px 22px}.home-library-heading{display:block}.home-library-heading .home-text-link{margin-top:18px}.home-catalog-row{grid-template-columns:minmax(0,1fr) 63px 20px;gap:12px;padding:24px 0}.home-catalog-number{display:none}.home-catalog-title h3{font-size:20px}.home-catalog-title>span{font-size:9px}.home-catalog-speed{font-size:18px}.home-catalog-speed small{font-size:8px}.home-catalog-note{font-size:10px}.home-closing{padding:53px 22px}.home-closing h2{font-size:40px}.home-footer{padding:32px 22px 25px}.home-footer-top{display:block;margin-bottom:28px}.home-footer-top nav{margin-top:25px;gap:25px;font-size:11px}.home-footer-bottom{flex-wrap:wrap;gap:16px;font-size:9px}.home-footer-bottom>span:nth-child(2){display:none}.home-footer-bottom>div{margin-left:auto;gap:15px}}

